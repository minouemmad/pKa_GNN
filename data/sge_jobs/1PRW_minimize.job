#!/bin/bash
#$ -V
#$ -cwd
#$ -N min_1PRW
#$ -j y
#$ -q MS,UI-GPU-HM
#$ -pe smp 20
#$ -o $JOB_NAME.$JOB_ID.log
#$ -l h_rt=10000:00:00
#$ -S /bin/bash
#$ -l ngpus=1

# ── Environment ───────────────────────────────────────────────────────────────
echo "Job started: $(date)"
echo "Host: $(hostname)"
echo "PDB: /Dedicated/schnieders/maemmad/pKa_GNN/data/raw_pdbs/1PRW.pdb"

# ── Step 1: Coarse minimization with GK implicit solvent ──────────────────────
# Produces: /Dedicated/schnieders/maemmad/pKa_GNN/data/raw_pdbs/1PRW_min.pdb
echo "=== Step 1: Coarse Minimize (RMS=0.8) ==="
/Dedicated/schnieders/maemmad/forcefieldx/bin/ffxc Minimize \
    -e 0.8 \
    /Dedicated/schnieders/maemmad/pKa_GNN/data/raw_pdbs/1PRW.pdb \
    -Dplatform=OMM \
    -Dkey=data/raw_pdbs/1PRW.properties

if [ ! -f "/Dedicated/schnieders/maemmad/pKa_GNN/data/raw_pdbs/1PRW_min.pdb" ]; then
    echo "ERROR: Step 1 output not found: /Dedicated/schnieders/maemmad/pKa_GNN/data/raw_pdbs/1PRW_min.pdb"
    exit 1
fi

# ── Step 2: Start Parallel Java scheduler (background) ────────────────────────
echo "=== Step 2: Starting Scheduler ==="
/Dedicated/schnieders/maemmad/forcefieldx/bin/ffxc Scheduler -p 5 -m 22G > scheduler_1PRW.log &
SCHEDULER_PID=$!
sleep 30s

# ── Step 3: Many-body rotamer optimization ────────────────────────────────────
# Input:    /Dedicated/schnieders/maemmad/pKa_GNN/data/raw_pdbs/1PRW_min.pdb
# Produces: /Dedicated/schnieders/maemmad/pKa_GNN/data/raw_pdbs/1PRW_min_2.pdb
echo "=== Step 3: ManyBody Rotamer Optimization ==="
/Dedicated/schnieders/maemmad/forcefieldx/bin/ffxc ManyBody \
    -Dpj.nn=4 \
    -Dpj.nt=5 \
    -DnumCudaDevices=1 \
    -Dplatform=OMM \
    /Dedicated/schnieders/maemmad/pKa_GNN/data/raw_pdbs/1PRW_min.pdb \
    -Dkey=data/raw_pdbs/1PRW.properties

# Shut down scheduler
kill $SCHEDULER_PID 2>/dev/null || true

if [ ! -f "/Dedicated/schnieders/maemmad/pKa_GNN/data/raw_pdbs/1PRW_min_2.pdb" ]; then
    echo "ERROR: Step 3 output not found: /Dedicated/schnieders/maemmad/pKa_GNN/data/raw_pdbs/1PRW_min_2.pdb"
    echo "Falling back to Step 1 output for final minimize."
    pdb_s4_in="/Dedicated/schnieders/maemmad/pKa_GNN/data/raw_pdbs/1PRW_min.pdb"
else
    pdb_s4_in="/Dedicated/schnieders/maemmad/pKa_GNN/data/raw_pdbs/1PRW_min_2.pdb"
fi

# ── Step 4: Tight final minimization on GPU + write induced dipoles ────────────
# --saveInduced writes <basename>.uind alongside the output PDB.
# This is the file the multipole extraction Groovy script reads.
echo "=== Step 4: Final Minimize (RMS=0.1, GPU, saveInduced) ==="
/Dedicated/schnieders/maemmad/forcefieldx/bin/ffxc MinimizeOpenMM \
    -e 0.1 \
    "${pdb_s4_in}" \
    -Dkey=data/raw_pdbs/1PRW.properties \
    --saveInduced

echo "=== Done: $(date) ==="
