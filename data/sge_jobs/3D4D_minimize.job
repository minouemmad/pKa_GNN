#!/bin/bash
#$ -V
#$ -cwd
#$ -N min_3D4D
#$ -j y
#$ -q MS,UI-GPU
#$ -pe smp 20
#$ -o $JOB_NAME.$JOB_ID.log
#$ -l h_rt=10000:00:00
#$ -S /bin/bash
#$ -l ngpus=1

# ── Environment ───────────────────────────────────────────────────────────────
echo "Job started: $(date)"
echo "Host: $(hostname)"
echo "PDB: /Dedicated/schnieders/maemmad/pKa_GNN/data/fixed_pdbs/3D4D_fixed.pdb"

# ── Step 1: Coarse minimization with GK implicit solvent ──────────────────────
# FFX outputs: /Dedicated/schnieders/maemmad/pKa_GNN/data/fixed_pdbs/3D4D_fixed.pdb_2
echo "=== Step 1: Coarse Minimize (RMS=0.8) ==="
/Dedicated/schnieders/maemmad/forcefieldx/bin/ffxc Minimize \
    -e 0.8 \
    /Dedicated/schnieders/maemmad/pKa_GNN/data/fixed_pdbs/3D4D_fixed.pdb \
    -Dkey=data/fixed_pdbs/3D4D.properties

if [ ! -f "/Dedicated/schnieders/maemmad/pKa_GNN/data/fixed_pdbs/3D4D_fixed.pdb_2" ]; then
    echo "ERROR: Step 1 output not found: /Dedicated/schnieders/maemmad/pKa_GNN/data/fixed_pdbs/3D4D_fixed.pdb_2"
    exit 1
fi

# Rename for ManyBody input
echo "=== Renaming /Dedicated/schnieders/maemmad/pKa_GNN/data/fixed_pdbs/3D4D_fixed.pdb_2 to /Dedicated/schnieders/maemmad/pKa_GNN/data/fixed_pdbs/3D4D_fixed_min.pdb ==="
mv "/Dedicated/schnieders/maemmad/pKa_GNN/data/fixed_pdbs/3D4D_fixed.pdb_2" "/Dedicated/schnieders/maemmad/pKa_GNN/data/fixed_pdbs/3D4D_fixed_min.pdb"

# ── Step 2: Start Parallel Java scheduler (background) ────────────────────────
echo "=== Step 2: Starting Scheduler ==="
/Dedicated/schnieders/maemmad/forcefieldx/bin/ffxc Scheduler -p 5 -m 22G > scheduler_3D4D.log &
SCHEDULER_PID=$!
sleep 30s

# ── Step 3: Many-body rotamer optimization ────────────────────────────────────
# Input: /Dedicated/schnieders/maemmad/pKa_GNN/data/fixed_pdbs/3D4D_fixed_min.pdb
# FFX outputs: /Dedicated/schnieders/maemmad/pKa_GNN/data/fixed_pdbs/3D4D_fixed_min.pdb_2
echo "=== Step 3: ManyBody Rotamer Optimization ==="
/Dedicated/schnieders/maemmad/forcefieldx/bin/ffxc ManyBody \
    -Dpj.nn=4 \
    -Dpj.nt=5 \
    -DnumCudaDevices=1 \
    /Dedicated/schnieders/maemmad/pKa_GNN/data/fixed_pdbs/3D4D_fixed_min.pdb \
    -Dkey=data/fixed_pdbs/3D4D.properties

# Shut down scheduler
kill $SCHEDULER_PID 2>/dev/null || true

if [ ! -f "/Dedicated/schnieders/maemmad/pKa_GNN/data/fixed_pdbs/3D4D_fixed_min.pdb_2" ]; then
    echo "ERROR: Step 3 output not found: /Dedicated/schnieders/maemmad/pKa_GNN/data/fixed_pdbs/3D4D_fixed_min.pdb_2"
    echo "Falling back to Step 1 output for final minimize."
    pdb_s4_in="/Dedicated/schnieders/maemmad/pKa_GNN/data/fixed_pdbs/3D4D_fixed_min.pdb"
else
    # Rename for final minimize
    echo "=== Renaming /Dedicated/schnieders/maemmad/pKa_GNN/data/fixed_pdbs/3D4D_fixed_min.pdb_2 to /Dedicated/schnieders/maemmad/pKa_GNN/data/fixed_pdbs/3D4D_fixed_min_2.pdb ==="
    mv "/Dedicated/schnieders/maemmad/pKa_GNN/data/fixed_pdbs/3D4D_fixed_min.pdb_2" "/Dedicated/schnieders/maemmad/pKa_GNN/data/fixed_pdbs/3D4D_fixed_min_2.pdb"
    pdb_s4_in="/Dedicated/schnieders/maemmad/pKa_GNN/data/fixed_pdbs/3D4D_fixed_min_2.pdb"
fi

# ── Step 4: Tight final minimization on GPU + write induced dipoles ────────────
# --saveInduced writes <basename>.uind alongside the output PDB.
echo "=== Step 4: Final Minimize (RMS=0.1, GPU, saveInduced) ==="
/Dedicated/schnieders/maemmad/forcefieldx/bin/ffxc Minimize \
    -e 0.1 \
    "${pdb_s4_in}" \
    -Dkey=data/fixed_pdbs/3D4D.properties \
    --saveInduced

echo "=== Done: $(date) ==="
