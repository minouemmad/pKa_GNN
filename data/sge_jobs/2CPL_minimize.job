#!/bin/bash
#$ -V
#$ -cwd
#$ -N min_2CPL
#$ -j y
#$ -q MS,UI-GPU
#$ -pe smp 20
#$ -o $JOB_NAME.$JOB_ID.log
#$ -l h_rt=10000:00:00
#$ -S /bin/bash
#$ -l ngpus=1

echo "Job started: $(date)"
echo "Host: $(hostname)"

BASE=/Dedicated/schnieders/maemmad/pKa_GNN/data/fixed_pdbs
FFX=/Dedicated/schnieders/maemmad/forcefieldx/bin/ffxc
PROPS="-Dkey=data/fixed_pdbs/2CPL.properties"
PDB_IN="${BASE}/2CPL_fixed.pdb"

# ── Step 1a: No polarization — relax idealized H atoms, zero SCF cost ─────────
echo "=== Step 1a: Minimize polarization=NONE (RMS=2.0) ==="
${FFX} Minimize -e 2.0 "${PDB_IN}" ${PROPS} -Dpolarization=NONE
if [ ! -f "${PDB_IN}_2" ]; then
    echo "ERROR: Step 1a output not found: ${PDB_IN}_2"; exit 1
fi
mv "${PDB_IN}_2" "${BASE}/2CPL_s1a.pdb"

# ── Step 1b: Direct polarization — still no SCF iterations ────────────────────
echo "=== Step 1b: Minimize polarization=DIRECT (RMS=1.0) ==="
${FFX} Minimize -e 1.0 "${BASE}/2CPL_s1a.pdb" ${PROPS} -Dpolarization=DIRECT
if [ ! -f "${BASE}/2CPL_s1a.pdb_2" ]; then
    echo "ERROR: Step 1b output not found: ${BASE}/2CPL_s1a.pdb_2"; exit 1
fi
mv "${BASE}/2CPL_s1a.pdb_2" "${BASE}/2CPL_s1b.pdb"

# ── Step 1c: Mutual polarization — geometry now conditioned for SCF ────────────
echo "=== Step 1c: Minimize polarization=MUTUAL (RMS=0.8) ==="
${FFX} Minimize -e 0.8 "${BASE}/2CPL_s1b.pdb" ${PROPS} -Dpolarization=MUTUAL
if [ ! -f "${BASE}/2CPL_s1b.pdb_2" ]; then
    echo "ERROR: Step 1c output not found: ${BASE}/2CPL_s1b.pdb_2"; exit 1
fi
mv "${BASE}/2CPL_s1b.pdb_2" "${BASE}/2CPL_fixed_min.pdb"

# ── Step 2: Start Parallel Java scheduler (background) ────────────────────────
echo "=== Step 2: Starting Scheduler ==="
${FFX} Scheduler -p 5 -m 22G > scheduler_2CPL.log &
SCHEDULER_PID=$!
sleep 30s

# ── Step 3: Many-body rotamer optimization ────────────────────────────────────
echo "=== Step 3: ManyBody Rotamer Optimization ==="
${FFX} ManyBody \
    -Dpj.nn=4 \
    -Dpj.nt=5 \
    -DnumCudaDevices=1 \
    "${BASE}/2CPL_fixed_min.pdb" \
    ${PROPS}

kill $SCHEDULER_PID 2>/dev/null || true

if [ ! -f "${BASE}/2CPL_fixed_min.pdb_2" ]; then
    echo "WARNING: Step 3 output not found, falling back to Step 1c output."
    pdb_s4_in="${BASE}/2CPL_fixed_min.pdb"
else
    mv "${BASE}/2CPL_fixed_min.pdb_2" "${BASE}/2CPL_fixed_min_2.pdb"
    pdb_s4_in="${BASE}/2CPL_fixed_min_2.pdb"
fi

# ── Step 4: Tight final minimization + write induced dipoles ──────────────────
echo "=== Step 4: Final Minimize (RMS=0.1, saveInduced) ==="
${FFX} Minimize -e 0.1 "${pdb_s4_in}" ${PROPS} --saveInduced
if [ ! -f "${pdb_s4_in}_2" ]; then
    echo "ERROR: Step 4 output not found: ${pdb_s4_in}_2"; exit 1
fi
mv "${pdb_s4_in}_2" "${BASE}/2CPL_final.pdb"

echo "=== Done: $(date) ==="
echo "Final structure: ${BASE}/2CPL_final.pdb"
