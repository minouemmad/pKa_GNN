#!/bin/bash
#$ -V
#$ -cwd
#$ -N train_paper
#$ -j y
#$ -q UI,MS
#$ -pe smp 10
#$ -o $JOB_NAME.$JOB_ID.log
#$ -l h_rt=48:00:00
#$ -S /bin/bash

conda activate /Dedicated/schnieders/programs/anaconda3/envs/mda_env

echo "Job started : $(date)"
echo "Host        : $(hostname)"
echo "Working dir : $PWD"

PROJECT=/Dedicated/schnieders/maemmad/pKa_GNN
PYTHON=/Dedicated/schnieders/programs/anaconda3-2024/bin/python

cd "$PROJECT" || { echo "ERROR: cannot cd to $PROJECT"; exit 1; }

echo ""
echo "=== 11_train_paper.py (grid-search best: L1, h=32, hd=8, lr=0.1, d=0.4) ==="
$PYTHON 11_train_paper.py \
    --loss L1 \
    --hidden 32 \
    --heads 8 \
    --lr 0.1 \
    --dropout 0.4 \
    --batch 32

echo ""
echo "Job finished: $(date)"
