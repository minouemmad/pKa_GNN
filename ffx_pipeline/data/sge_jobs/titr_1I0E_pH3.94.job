#!/bin/bash
#$ -V                        # Inherit current environment
#$ -cwd                      # Start job in submission directory
#$ -N titr_1I0E_pH3p94             # Job Name
#$ -j y                      # Combine stderr and stdout
#$ -q MS,UI-GPU              # Queue
#$ -pe smp 20                # Request 20 tasks/node
#$ -o $JOB_NAME.$JOB_ID.log  # Name of output file
#$ -l h_rt=10000:00:00        # Run Time
#$ -S /bin/bash              # Shell to use
#$ -l ngpus=1
#$ -hold_jid rot_1I0E   # Wait for rotamer job if still running

echo "=== Titration pH 3.94 started: $(date) ==="

# Verify rotamer output exists before proceeding
if [ ! -f "/Dedicated/schnieders/maemmad/pKa_GNN/ffx_pipeline/data/fixed_pdbs/1I0E/1I0E_input.pdb_3" ]; then
  echo "ERROR: rotamer output not found: /Dedicated/schnieders/maemmad/pKa_GNN/ffx_pipeline/data/fixed_pdbs/1I0E/1I0E_input.pdb_3" >&2
  exit 1
fi

# Copy rotamer output so each pH run has its own working copy (pdb_3 is never modified)
cp "/Dedicated/schnieders/maemmad/pKa_GNN/ffx_pipeline/data/fixed_pdbs/1I0E/1I0E_input.pdb_3" "/Dedicated/schnieders/maemmad/pKa_GNN/ffx_pipeline/data/fixed_pdbs/1I0E/1I0E_pH3.94.pdb"

# Titration rotamer optimization at pH 3.94
/Dedicated/schnieders/maemmad/forcefieldx/bin/ffxc Scheduler -p 20 -m 22G > scheduler_rotamer.log & sleep 30s
/Dedicated/schnieders/rgogal/software/forcefieldx/bin/ffxc ManyBody --tR --pH 3.94 --oT -T --kPH 3.0 "/Dedicated/schnieders/maemmad/pKa_GNN/ffx_pipeline/data/fixed_pdbs/1I0E/1I0E_pH3.94.pdb" -Dkey=/Dedicated/schnieders/maemmad/pKa_GNN/ffx_pipeline/data/fixed_pdbs/1I0E/titrate.properties

# Final minimize — saves induced dipoles (.uind) and permanent multipoles (.uperm)
/Dedicated/schnieders/maemmad/forcefieldx/bin/ffxc Minimize -e 0.1 "/Dedicated/schnieders/maemmad/pKa_GNN/ffx_pipeline/data/fixed_pdbs/1I0E/1I0E_pH3.94.pdb_2" -Dkey=/Dedicated/schnieders/maemmad/pKa_GNN/ffx_pipeline/data/fixed_pdbs/1I0E/1I0E_input.properties --saveInduced --savePermanentMoments

echo "=== Titration pH 3.94 done: $(date) ==="
